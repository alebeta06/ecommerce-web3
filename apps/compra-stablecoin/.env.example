# compra-stablecoin — environment variables (template, NO real secrets here)
# 🇪🇸 NOTA: Copia a `.env.local` y rellena. Las NEXT_PUBLIC_* son públicas (van al navegador).
# Las server-only (sin prefijo) SOLO existen en el servidor / API routes y NUNCA deben llevar
# NEXT_PUBLIC_ (expondría el secreto al bundle del cliente). `.env.local` está gitignored.

# ── Públicas (navegador + servidor) ─────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# 🇪🇸 EuroToken (Anvil cuenta 0, nonce 0) — determinista:
NEXT_PUBLIC_EUROTOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_PAYMENT_GATEWAY_URL=http://localhost:6002

# ── Server-only (solo API routes; NUNCA al cliente) ─────────────────────
# 🇪🇸 Stripe secret key: crea el PaymentIntent y verifica su estado en el backend.
STRIPE_SECRET_KEY=sk_test_xxx
# 🇪🇸 Wallet OWNER del EuroToken (acct0 de Anvil): única autorizada a mint(). Firma el mint tras
# verificar el pago. En producción esto sería una clave gestionada (KMS/HSM), nunca en texto plano.
WALLET_PRIVATE_KEY=0x...
# 🇪🇸 RPC server-side para el provider de ethers en la API route del mint.
RPC_URL=http://localhost:8545

# Nombre legible de la red esperada (se muestra en el guard de red). Fallback al chainId si falta.
# En Sepolia: "Ethereum Sepolia".
NEXT_PUBLIC_NETWORK_NAME=Anvil (local)
