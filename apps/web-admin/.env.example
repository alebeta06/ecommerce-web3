# web-admin — environment variables (template, NO secrets here)
# 🇪🇸 NOTA: Copia a `.env.local` y rellena. Las NEXT_PUBLIC_* se exponen al navegador (no
# secretas); PINATA_JWT es secreto (solo servidor). `.env.local` está gitignored.

# ── Blockchain (Anvil local) ────────────────────────────────────────────
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_CHAIN_ID=31337
# 🇪🇸 Addresses del despliegue. En Anvil (cuenta 0, nonces 0 y 1) son deterministas:
#   EuroToken = 0x5FbDB2315678afecb367f032d93F642f64180aa3
#   Ecommerce = 0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_EURO_TOKEN_ADDRESS=
NEXT_PUBLIC_ECOMMERCE_ADDRESS=

# ── IPFS (Pinata) ───────────────────────────────────────────────────────
PINATA_JWT=                                   # server-side, for uploads
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/   # public read gateway

# Nombre legible de la red esperada (se muestra en el guard de red). Fallback al chainId si falta.
# En Sepolia: "Ethereum Sepolia".
NEXT_PUBLIC_NETWORK_NAME=Anvil (local)

# ── Escaneo de eventos (eth_getLogs) ────────────────────────────────────
# 🇪🇸 La pestaña Customers descubre clientes leyendo el evento CustomerRegistered (el contrato no
# expone getAllCustomers). Eso exige eth_getLogs, que cada RPC de free tier capa distinto. Solución
# final: dRPC para el escaneo (sirve archive, sin key) + ventana 9000 + sin JSON-RPC batching.
# Todas tienen default seguro: en Anvil NO hace falta tocar ninguna. Detalle completo en docs/RPC_NOTES.md.
#
# 🇪🇸 Bloque de despliegue del contrato Ecommerce: arranque del escaneo (evita recorrer bloques
# vacíos previos). Default 0 (Anvil). En Sepolia: 11146508.
NEXT_PUBLIC_DEPLOY_BLOCK=0
# 🇪🇸 Tamaño de ventana de bloques por petición. Default 10 (seguro en cualquier RPC).
# En Sepolia: 9000 — dRPC free tier rechaza rangos >= 10000 bloques (helper usa span = ventana-1).
NEXT_PUBLIC_LOG_WINDOW_SIZE=10
# 🇪🇸 RPC dedicado al escaneo de logs. Alchemy free capa eth_getLogs a 10 bloques; PublicNode bloquea
# archive sin token; otros piden API key o caps mínimos. dRPC sirve archive sin key con rango <10000.
# Opcional: si falta, cae a NEXT_PUBLIC_RPC_URL (en Anvil usa el nodo local -> idéntico). En Sepolia:
#   https://sepolia.drpc.org   (sin API key)
# OJO: el provider de logs usa batchMaxCount:1 (en useEcommerce.ts) porque ethers v6 agrupa llamadas
# en un JSON-RPC batch y dRPC free rechaza batches > 3. Es código, no env var.
NEXT_PUBLIC_LOGS_RPC_URL=
# 🇪🇸 Peticiones eth_getLogs simultáneas durante el escaneo (throttle anti-429). Default 4.
NEXT_PUBLIC_LOG_CONCURRENCY=4
